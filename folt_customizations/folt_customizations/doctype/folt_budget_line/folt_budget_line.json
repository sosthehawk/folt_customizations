{
  "doctype": "DocType",
  "name": "FoLT Budget Line",
  "module": "Folt Customizations",
  "custom": 0,
  "allow_import": 1,
  "description": "How programme money is classified: categories, lines, donor budget codes.",
  "autoname": "field:budget_line_code",
  "naming_rule": "By fieldname",
  "title_field": "budget_line_name",
  "search_fields": "budget_line_name,classification",
  "is_tree": 1,
  "nsm_parent_field": "parent_folt_budget_line",
  "track_changes": 1,
  "show_title_field_in_link": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "budget_line_name", "fieldtype": "Data", "label": "Budget line", "reqd": 1, "in_list_view": 1, "bold": 1 },
    { "fieldname": "budget_line_code", "fieldtype": "Data", "label": "Code", "unique": 1, "in_list_view": 1, "set_only_once": 1, "description": "Left blank, a code is generated from the prefix in Master Data Settings. It is the record's name." },
    { "fieldname": "classification", "fieldtype": "Select", "label": "Classification", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "options": "Budget category\nBudget line\nCost classification\nExpenditure category\nFinancial reporting category\nDonor budget code" },
    { "fieldname": "parent_folt_budget_line", "fieldtype": "Link", "options": "FoLT Budget Line", "label": "Within", "in_standard_filter": 1 },
    { "fieldname": "is_group", "fieldtype": "Check", "label": "Has children (group)" },
    { "fieldname": "lft", "fieldtype": "Int", "label": "Left", "hidden": 1, "read_only": 1, "no_copy": 1, "search_index": 1 },
    { "fieldname": "rgt", "fieldtype": "Int", "label": "Right", "hidden": 1, "read_only": 1, "no_copy": 1, "search_index": 1 },
    { "fieldname": "old_parent", "fieldtype": "Link", "options": "FoLT Budget Line", "label": "Old parent", "hidden": 1, "read_only": 1 },
    { "fieldname": "account", "fieldtype": "Link", "label": "Expense account", "options": "Account", "description": "The ERPNext account costs on this line post to. The ledger stays Finance's." },
    { "fieldname": "donor", "fieldtype": "Link", "label": "Donor", "options": "FoLT Donor", "description": "For a donor's own budget code." },
    { "fieldname": "description", "fieldtype": "Small Text", "label": "Description" },
    { "fieldname": "lifecycle_section", "fieldtype": "Section Break", "label": "Lifecycle", "collapsible": 1 },
    { "fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Status", "read_only": 1, "no_copy": 1, "in_standard_filter": 1 },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "read_only": 1, "no_copy": 1, "default": "0", "in_standard_filter": 1 },
    { "fieldname": "folt_rejection_reason", "fieldtype": "Small Text", "label": "Reason turned down", "read_only": 1, "no_copy": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Administrator", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1 },
    { "role": "Master Data Approver", "read": 1, "write": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Program Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Program Officer", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1 },
    { "role": "M&E Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Auditor", "read": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
