{
  "doctype": "DocType",
  "name": "FoLT Donor",
  "module": "Folt Customizations",
  "custom": 0,
  "allow_import": 1,
  "description": "A funder. The Donor accounting dimension.",
  "autoname": "field:donor_name",
  "naming_rule": "By fieldname",
  "title_field": "donor_name",
  "search_fields": "donor_code,organization_type",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "donor_name", "fieldtype": "Data", "label": "Donor name", "reqd": 1, "unique": 1, "in_list_view": 1, "bold": 1 },
    { "fieldname": "donor_code", "fieldtype": "Data", "label": "Donor code", "in_list_view": 1, "description": "Left blank, a code is generated from the prefix in Master Data Settings." },
    { "fieldname": "organization_type", "fieldtype": "Select", "label": "Organisation type", "options": "\nBilateral\nMultilateral\nFoundation\nGovernment\nCorporate\nNGO\nIndividual\nOther", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "contact_section", "fieldtype": "Section Break", "label": "Contact", "collapsible": 0 },
    { "fieldname": "contact_person", "fieldtype": "Data", "label": "Contact person", "permlevel": 1 },
    { "fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email", "permlevel": 1 },
    { "fieldname": "telephone", "fieldtype": "Data", "label": "Telephone", "options": "Phone", "permlevel": 1 },
    { "fieldname": "contact_column", "fieldtype": "Column Break" },
    { "fieldname": "website", "fieldtype": "Data", "label": "Website", "options": "URL" },
    { "fieldname": "physical_address", "fieldtype": "Small Text", "label": "Physical address", "permlevel": 1 },
    { "fieldname": "agreement_section", "fieldtype": "Section Break", "label": "Funding agreement" },
    { "fieldname": "agreement_reference", "fieldtype": "Data", "label": "Agreement reference", "permlevel": 1 },
    { "fieldname": "funding_currency", "fieldtype": "Link", "label": "Funding currency", "options": "Currency" },
    { "fieldname": "agreement_column", "fieldtype": "Column Break" },
    { "fieldname": "funding_start", "fieldtype": "Date", "label": "Funding from" },
    { "fieldname": "funding_end", "fieldtype": "Date", "label": "Funding until" },
    { "fieldname": "conditions_section", "fieldtype": "Section Break" },
    { "fieldname": "funding_conditions", "fieldtype": "Text", "label": "Funding conditions", "permlevel": 1 },
    { "fieldname": "reporting_requirements", "fieldtype": "Text", "label": "Reporting requirements", "description": "What the donor asks to be told, and when. Reporting periods carry the dates." },
    { "fieldname": "lifecycle_section", "fieldtype": "Section Break", "label": "Lifecycle", "collapsible": 1 },
    { "fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Status", "read_only": 1, "no_copy": 1, "in_standard_filter": 1 },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "read_only": 1, "no_copy": 1, "default": "0", "in_standard_filter": 1 },
    { "fieldname": "folt_rejection_reason", "fieldtype": "Small Text", "label": "Reason turned down", "read_only": 1, "no_copy": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Administrator", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1 },
    { "role": "Master Data Approver", "read": 1, "write": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Program Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Program Officer", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1 },
    { "role": "M&E Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Auditor", "read": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Employee", "read": 1 },
    { "role": "Accounts Manager", "permlevel": 1, "read": 1, "write": 1 },
    { "role": "Auditor", "permlevel": 1, "read": 1 },
    { "role": "Head of Programs", "permlevel": 1, "read": 1, "write": 1 },
    { "role": "Master Data Administrator", "permlevel": 1, "read": 1, "write": 1 },
    { "role": "Master Data Approver", "permlevel": 1, "read": 1 },
    { "role": "Program Manager", "permlevel": 1, "read": 1, "write": 1 },
    { "role": "System Manager", "permlevel": 1, "read": 1, "write": 1 }
  ]
}
