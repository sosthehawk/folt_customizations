{
  "doctype": "DocType",
  "name": "FoLT Funding Allocation",
  "module": "Folt Customizations",
  "custom": 0,
  "description": "Money from a funding source set aside for a programme.",
  "autoname": "field:allocation_code",
  "naming_rule": "By fieldname",
  "title_field": "allocation_title",
  "search_fields": "allocation_title,program,funding_source",
  "track_changes": 1,
  "show_title_field_in_link": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "allocation_code", "fieldtype": "Data", "label": "Code", "unique": 1, "in_list_view": 1, "set_only_once": 1, "description": "Left blank, a code is generated from the prefix in Master Data Settings. It is the record's name." },
    { "fieldname": "allocation_title", "fieldtype": "Data", "label": "Allocation", "reqd": 1, "in_list_view": 1, "bold": 1 },
    { "fieldname": "program", "fieldtype": "Link", "label": "Programme", "options": "FoLT Program", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "funding_source", "fieldtype": "Link", "label": "Funding source", "options": "FoLT Grant Project", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "donor", "fieldtype": "Link", "label": "Donor", "options": "FoLT Donor", "fetch_from": "funding_source.donor", "read_only": 1 },
    { "fieldname": "budget_line", "fieldtype": "Link", "label": "Budget line", "options": "FoLT Budget Line" },
    { "fieldname": "alloc_column", "fieldtype": "Column Break" },
    { "fieldname": "fiscal_year", "fieldtype": "Link", "label": "Fiscal year", "options": "Fiscal Year", "in_standard_filter": 1 },
    { "fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "fetch_from": "funding_source.grant_currency", "fetch_if_empty": 1 },
    { "fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "options": "currency", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "finance_section", "fieldtype": "Section Break", "label": "In Finance", "description": "Where Finance tracks this money. The allocation posts nothing; budgets and postings stay Finance's." },
    { "fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company" },
    { "fieldname": "cost_center", "fieldtype": "Link", "label": "Cost centre", "options": "Cost Center" },
    { "fieldname": "finance_column", "fieldtype": "Column Break" },
    { "fieldname": "project", "fieldtype": "Link", "label": "Project", "options": "Project" },
    { "fieldname": "budget", "fieldtype": "Link", "label": "ERPNext budget", "options": "Budget" },
    { "fieldname": "lifecycle_section", "fieldtype": "Section Break", "label": "Lifecycle", "collapsible": 1 },
    { "fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Status", "read_only": 1, "no_copy": 1, "in_standard_filter": 1 },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "read_only": 1, "no_copy": 1, "default": "0", "in_standard_filter": 1 },
    { "fieldname": "folt_rejection_reason", "fieldtype": "Small Text", "label": "Reason turned down", "read_only": 1, "no_copy": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Administrator", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1 },
    { "role": "Master Data Approver", "read": 1, "write": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "share": 1 },
    { "role": "Program Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Program Officer", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1 },
    { "role": "M&E Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Auditor", "read": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
