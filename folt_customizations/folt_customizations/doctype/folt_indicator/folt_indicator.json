{
  "doctype": "DocType",
  "name": "FoLT Indicator",
  "module": "Folt Customizations",
  "custom": 0,
  "allow_import": 1,
  "description": "How progress is measured.",
  "autoname": "field:indicator_code",
  "naming_rule": "By fieldname",
  "title_field": "indicator_name",
  "search_fields": "indicator_name,indicator_type",
  "track_changes": 1,
  "show_title_field_in_link": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "indicator_code", "fieldtype": "Data", "label": "Code", "unique": 1, "in_list_view": 1, "set_only_once": 1, "description": "Left blank, a code is generated from the prefix in Master Data Settings. It is the record's name." },
    { "fieldname": "indicator_name", "fieldtype": "Data", "label": "Indicator", "reqd": 1, "in_list_view": 1, "bold": 1 },
    { "fieldname": "indicator_type", "fieldtype": "Select", "label": "Indicator type", "options": "Quantitative\nQualitative", "default": "Quantitative", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "output", "fieldtype": "Link", "label": "Output", "options": "FoLT Output", "in_standard_filter": 1 },
    { "fieldname": "outcome", "fieldtype": "Link", "label": "Outcome", "options": "FoLT Outcome", "in_standard_filter": 1, "description": "For an indicator that measures an outcome rather than an output." },
    { "fieldname": "description", "fieldtype": "Small Text", "label": "Description" },
    { "fieldname": "measure_section", "fieldtype": "Section Break", "label": "Measure" },
    { "fieldname": "uom", "fieldtype": "Link", "label": "Unit", "options": "UOM", "depends_on": "eval:doc.indicator_type=='Quantitative'" },
    { "fieldname": "baseline_value", "fieldtype": "Float", "label": "Baseline", "depends_on": "eval:doc.indicator_type=='Quantitative'" },
    { "fieldname": "target_value", "fieldtype": "Float", "label": "Target", "depends_on": "eval:doc.indicator_type=='Quantitative'" },
    { "fieldname": "qualitative_target", "fieldtype": "Small Text", "label": "Target (described)", "depends_on": "eval:doc.indicator_type=='Qualitative'" },
    { "fieldname": "measure_column", "fieldtype": "Column Break" },
    { "fieldname": "frequency", "fieldtype": "Select", "label": "Measured", "options": "\nMonthly\nQuarterly\nSemiannual\nAnnual\nOnce" },
    { "fieldname": "data_source", "fieldtype": "Data", "label": "Data source" },
    { "fieldname": "verification_method", "fieldtype": "Data", "label": "Verification method" },
    { "fieldname": "department", "fieldtype": "Link", "label": "Responsible department", "options": "Department" },
    { "fieldname": "lifecycle_section", "fieldtype": "Section Break", "label": "Lifecycle", "collapsible": 1 },
    { "fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Status", "read_only": 1, "no_copy": 1, "in_standard_filter": 1 },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "read_only": 1, "no_copy": 1, "default": "0", "in_standard_filter": 1 },
    { "fieldname": "folt_rejection_reason", "fieldtype": "Small Text", "label": "Reason turned down", "read_only": 1, "no_copy": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Administrator", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Approver", "read": 1, "write": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Program Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Program Officer", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1 },
    { "role": "M&E Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Auditor", "read": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
