{
  "doctype": "DocType",
  "name": "FoLT Location",
  "module": "Folt Customizations",
  "custom": 0,
  "autoname": "field:location_name",
  "naming_rule": "By fieldname",
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "location_name", "fieldtype": "Data", "label": "Location name", "reqd": 1, "unique": 1, "in_list_view": 1 },
    { "fieldname": "parent_region", "fieldtype": "Data", "label": "Parent region" },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 },
    { "role": "Accounts Manager", "read": 1, "write": 1, "create": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
