{
  "doctype": "DocType",
  "name": "FoLT Program",
  "module": "Folt Customizations",
  "custom": 0,
  "allow_import": 1,
  "description": "A programme: the Program accounting dimension, classified and placed.",
  "autoname": "field:program_name",
  "naming_rule": "By fieldname",
  "title_field": "program_name",
  "search_fields": "program_code,category",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "program_name", "fieldtype": "Data", "label": "Program name", "reqd": 1, "unique": 1, "in_list_view": 1, "bold": 1 },
    { "fieldname": "program_code", "fieldtype": "Data", "label": "Code", "in_list_view": 1, "description": "Left blank, a code is generated from the prefix in Master Data Settings." },
    { "fieldname": "description", "fieldtype": "Small Text", "label": "Description" },
    { "fieldname": "classification_section", "fieldtype": "Section Break", "label": "Classification" },
    { "fieldname": "category", "fieldtype": "Link", "label": "Category", "options": "FoLT Program Category", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "program_type", "fieldtype": "Link", "label": "Program type", "options": "FoLT Program Type", "in_standard_filter": 1 },
    { "fieldname": "classification_column", "fieldtype": "Column Break" },
    { "fieldname": "program_status", "fieldtype": "Link", "label": "Programme status", "options": "FoLT Program Status", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "areas", "fieldtype": "Table MultiSelect", "label": "Program areas", "options": "FoLT Program Area Link" },
    { "fieldname": "ownership_section", "fieldtype": "Section Break", "label": "Ownership" },
    { "fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "in_standard_filter": 1 },
    { "fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department", "in_standard_filter": 1 },
    { "fieldname": "program_manager", "fieldtype": "Link", "label": "Programme manager", "options": "Employee" },
    { "fieldname": "program_manager_name", "fieldtype": "Data", "label": "Programme manager name", "fetch_from": "program_manager.employee_name", "read_only": 1 },
    { "fieldname": "ownership_column", "fieldtype": "Column Break" },
    { "fieldname": "cost_center", "fieldtype": "Link", "label": "Cost centre", "options": "Cost Center" },
    { "fieldname": "project", "fieldtype": "Link", "label": "Project", "options": "Project", "description": "The ERPNext project the programme's costs are tracked against, if it has one." },
    { "fieldname": "timeline_section", "fieldtype": "Section Break", "label": "Timeline and places" },
    { "fieldname": "start_date", "fieldtype": "Date", "label": "Start date" },
    { "fieldname": "timeline_column", "fieldtype": "Column Break" },
    { "fieldname": "end_date", "fieldtype": "Date", "label": "End date" },
    { "fieldname": "places_section", "fieldtype": "Section Break" },
    { "fieldname": "locations", "fieldtype": "Table MultiSelect", "label": "Implementation locations", "options": "FoLT Location Link" },
    { "fieldname": "results_section", "fieldtype": "Section Break", "label": "Results and activities" },
    { "fieldname": "objectives", "fieldtype": "Table MultiSelect", "label": "Objectives", "options": "FoLT Objective Link" },
    { "fieldname": "activities", "fieldtype": "Table MultiSelect", "label": "Activities", "options": "FoLT Activity Template Link" },
    { "fieldname": "people_section", "fieldtype": "Section Break", "label": "Who it serves" },
    { "fieldname": "target_groups", "fieldtype": "Table", "label": "Target groups", "options": "FoLT Program Target Group" },
    { "fieldname": "funding_section", "fieldtype": "Section Break", "label": "Funding" },
    { "fieldname": "funding", "fieldtype": "Table", "label": "Funding sources", "options": "FoLT Program Funding" },
    { "fieldname": "lifecycle_section", "fieldtype": "Section Break", "label": "Lifecycle", "collapsible": 1 },
    { "fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Status", "read_only": 1, "no_copy": 1, "in_standard_filter": 1 },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "read_only": 1, "no_copy": 1, "default": "0", "in_standard_filter": 1 },
    { "fieldname": "folt_rejection_reason", "fieldtype": "Small Text", "label": "Reason turned down", "read_only": 1, "no_copy": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Administrator", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1 },
    { "role": "Master Data Approver", "read": 1, "write": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Program Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Program Officer", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1 },
    { "role": "M&E Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Auditor", "read": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
