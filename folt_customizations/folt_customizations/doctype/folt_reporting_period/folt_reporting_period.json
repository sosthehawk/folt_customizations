{
  "doctype": "DocType",
  "name": "FoLT Reporting Period",
  "module": "Folt Customizations",
  "custom": 0,
  "description": "A period a programme reports on, and when the report is due.",
  "autoname": "field:period_code",
  "naming_rule": "By fieldname",
  "title_field": "period_name",
  "search_fields": "period_name,program,donor",
  "track_changes": 1,
  "show_title_field_in_link": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "period_code", "fieldtype": "Data", "label": "Code", "unique": 1, "in_list_view": 1, "set_only_once": 1, "description": "Left blank, a code is generated from the prefix in Master Data Settings. It is the record's name." },
    { "fieldname": "period_name", "fieldtype": "Data", "label": "Reporting period", "reqd": 1, "in_list_view": 1, "bold": 1 },
    { "fieldname": "frequency", "fieldtype": "Select", "label": "Frequency", "options": "Monthly\nQuarterly\nSemiannual\nAnnual\nCustom", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "program", "fieldtype": "Link", "label": "Programme", "options": "FoLT Program", "in_standard_filter": 1 },
    { "fieldname": "donor", "fieldtype": "Link", "label": "Donor", "options": "FoLT Donor", "in_standard_filter": 1 },
    { "fieldname": "rp_column", "fieldtype": "Column Break" },
    { "fieldname": "start_date", "fieldtype": "Date", "label": "From", "reqd": 1 },
    { "fieldname": "end_date", "fieldtype": "Date", "label": "To", "reqd": 1 },
    { "fieldname": "deadline", "fieldtype": "Date", "label": "Report due", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "reporting_status", "fieldtype": "Select", "label": "Report", "options": "Open\nSubmitted\nOverdue", "default": "Open", "in_list_view": 1, "in_standard_filter": 1, "description": "Overdue is set each day for an open report past its due date." },
    { "fieldname": "responsible", "fieldtype": "Link", "label": "Responsible", "options": "Employee", "description": "Reminded, at their login, before the report is due." },
    { "fieldname": "responsible_name", "fieldtype": "Data", "label": "Responsible name", "fetch_from": "responsible.employee_name", "read_only": 1 },
    { "fieldname": "requirements_section", "fieldtype": "Section Break" },
    { "fieldname": "requirements", "fieldtype": "Small Text", "label": "Reporting requirements" },
    { "fieldname": "lifecycle_section", "fieldtype": "Section Break", "label": "Lifecycle", "collapsible": 1 },
    { "fieldname": "workflow_state", "fieldtype": "Link", "options": "Workflow State", "label": "Status", "read_only": 1, "no_copy": 1, "in_standard_filter": 1 },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "read_only": 1, "no_copy": 1, "default": "0", "in_standard_filter": 1 },
    { "fieldname": "folt_rejection_reason", "fieldtype": "Small Text", "label": "Reason turned down", "read_only": 1, "no_copy": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Administrator", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1, "import": 1 },
    { "role": "Master Data Approver", "read": 1, "write": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "share": 1 },
    { "role": "Program Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Program Officer", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1 },
    { "role": "M&E Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Auditor", "read": 1, "report": 1, "export": 1, "print": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
