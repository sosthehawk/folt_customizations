{
  "doctype": "DocType",
  "name": "Participant Rate Schedule",
  "module": "Folt Customizations",
  "custom": 0,
  "autoname": "field:schedule_name",
  "naming_rule": "By fieldname",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    { "fieldname": "schedule_name", "fieldtype": "Data", "label": "Schedule name", "reqd": 1, "unique": 1, "in_list_view": 1 },
    { "fieldname": "project", "fieldtype": "Link", "options": "Project", "label": "Applies to project", "in_list_view": 1, "in_standard_filter": 1, "description": "Leave blank for the organisation-wide schedule. A project-specific schedule takes precedence over it." },
    { "fieldname": "column_break_head", "fieldtype": "Column Break" },
    { "fieldname": "valid_from", "fieldtype": "Date", "label": "Valid from", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "valid_upto", "fieldtype": "Date", "label": "Valid up to" },
    { "fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1 },
    { "fieldname": "section_break_rates", "fieldtype": "Section Break", "label": "Rates by location" },
    { "fieldname": "rates", "fieldtype": "Table", "options": "Participant Rate Schedule Line", "label": "Rates" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 },
    { "role": "Head of Finance", "read": 1, "write": 1, "create": 1, "report": 1 },
    { "role": "Head of Programs", "read": 1, "write": 1, "create": 1, "report": 1 },
    { "role": "Finance Officer", "read": 1, "report": 1 },
    { "role": "Employee", "read": 1 }
  ]
}
