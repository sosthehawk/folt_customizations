{
  "doctype": "DocType",
  "name": "Procurement Committee Evaluation",
  "module": "Folt Customizations",
  "custom": 0,
  "is_submittable": 1,
  "autoname": "format:PCE-{YYYY}-{#####}",
  "sort_field": "modified",
